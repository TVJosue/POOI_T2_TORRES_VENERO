@model POOI_T2_TORRES_VENERO.Models.Alumno

@{
    ViewBag.Title = "Agregar Alumno";
}

<h2>Agregar Alumno</h2>

@if (ViewBag.Mensaje != null)
{
    <div id="mensaje" class="alert alert-info">
        @ViewBag.Mensaje
    </div>
}

@using (Html.BeginForm("Agregar", "Alumno", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">

        <label>DNI</label>

        @Html.TextBoxFor(
            model => model.dni,
            new
            {
                @class = "form-control",
                required = "required",
                maxlength = "8"
            }
        )

    </div>

    <br />

    <div class="form-group">

        <label>Nombres</label>

        @Html.TextBoxFor(
            model => model.nombres,
            new
            {
                @class = "form-control",
                required = "required"
            }
        )

    </div>

    <br />

    <div class="form-group">

        <label>Apellidos</label>

        @Html.TextBoxFor(
            model => model.apellidos,
            new
            {
                @class = "form-control",
                required = "required"
            }
        )

    </div>

    <br />

    <div class="form-group">

        <label>Carrera</label>

        @Html.TextBoxFor(
            model => model.carrera,
            new
            {
                @class = "form-control",
                required = "required"
            }
        )

    </div>

    <br />

    <div class="form-group">

        <label>Ciclo</label>

        @Html.TextBoxFor(
            model => model.ciclo,
            new
            {
                @class = "form-control",
                type = "number",
                min = "1",
                required = "required"
            }
        )

    </div>

    <br />

    <button type="submit" class="btn btn-success">
        GUARDAR
    </button>

    @Html.ActionLink(
        "REGRESAR",
        "Index",
        "Alumno",
        null,
        new { @class = "btn btn-secondary" }
    )
}

<script>

    setTimeout(function () {

        var mensaje = document.getElementById("mensaje");

        if (mensaje) {
            mensaje.style.display = "none";
        }

    }, 5000);

</script>
